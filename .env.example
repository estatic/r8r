DATABASE_URL=sqlite:./r8r.db?mode=rwc
JWT_SECRET=change-me-in-production
# Must decode to exactly 32 raw bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
CREDENTIALS_KEY=change-me-in-production-32-bytes-base64
PORT=3000
# Once any user exists, POST /rest/auth/register is refused (403) unless
# this is set to "1" or "true". The very first registration always
# succeeds regardless of this setting.
R8R_ALLOW_OPEN_REGISTRATION=false
# Log verbosity. Default (unset): r8r's own events at info, other crates at
# warn. Examples: RUST_LOG=r8r=debug (adds every API request), RUST_LOG=debug.
# RUST_LOG=r8r=info,warn
# Also write logs to this file (plain text, rotated daily as
# r8r.log.YYYY-MM-DD); the terminal output stays. Unset = terminal only.
# R8R_LOG_FILE=./logs/r8r.log
