DATABASE_URL=sqlite:./r8r.db?mode=rwc
JWT_SECRET=change-me-in-production
# Must decode to exactly 32 raw bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
CREDENTIALS_KEY=change-me-in-production-32-bytes-base64
PORT=3000
# Once any user exists, POST /rest/auth/register is refused (403) unless
# this is set to "1" or "true". The very first registration always
# succeeds regardless of this setting.
R8R_ALLOW_OPEN_REGISTRATION=false
